# Copy to .env in this directory (deploy.sh does this for you on first
# deploy, and never overwrites it after). This is the production stack's
# config — unrelated to the repo root's .env, which is for local dev only.

# Your real domain (a subdomain is fine, e.g. hearts.example.com) — DNS
# A/AAAA record already pointed at the VPS's IP. Caddy requests its own
# Let's Encrypt certificate for it automatically.
DOMAIN=hearts.example.com

# Built + pushed by .github/workflows/build-and-push.yml. Replace <you>
# with your GitHub username/org once the repo is on GitHub and the
# workflow has run at least once.
HEARTS_IMAGE=ghcr.io/<you>/hearts-server:latest

# A real, generated password — not the "hearts"/"hearts" dev default.
POSTGRES_PASSWORD=changeme

# Must match DOMAIN over https — the browser path is same-origin (Caddy
# proxies /api/* to hearts-server on the same domain) so this mostly
# matters for direct API testing/tooling, not the web app itself.
CORS_ALLOWED_ORIGINS=https://hearts.example.com

# Optional overrides — defaults match crates/hearts-server/src/config.rs.
# TURN_TIMEOUT_SECS=300
# LOBBY_EXPIRY_SECS=1200
