"""Type stubs for `pyhearts` — PyO3 bindings for the hearts-core game engine.

Hand-maintained; keep in sync with `src/*.rs`. The engine is a
"tell me who acts and what's legal, then submit" design: `Game.round()` reports
whose turn it is (`next_bidder` / `next_player`) and what is legal
(`legal_bids` / `legal_plays`); `Game.place_bid` and `Game.play_card` are the
only mutating inputs.
"""

from __future__ import annotations

from enum import Enum
from typing import Optional

MIN_PLAYERS: int
MAX_PLAYERS: int
NUM_ROUNDS: int

class GameError(Exception):
    """Raised when the engine refuses an action (invalid seat, forbidden bid,
    must-follow-suit, and so on)."""

def score_delta(bid: int, tricks: int) -> int:
    """Round score for one player: exact bid earns tricks + 1; a miss loses the gap."""

def cards_for_round(round_index: int) -> int:
    """Cards dealt per player in round `round_index` (1..=13). Raises `ValueError`
    outside that range."""

class Suit(Enum):
    Clubs = ...
    Diamonds = ...
    Spades = ...
    Hearts = ...
    ALL: list[Suit]
    def is_trump(self) -> bool: ...

class Rank(Enum):
    Two = 2
    Three = 3
    Four = 4
    Five = 5
    Six = 6
    Seven = 7
    Eight = 8
    Nine = 9
    Ten = 10
    Jack = 11
    Queen = 12
    King = 13
    Ace = 14
    ALL: list[Rank]
    def value(self) -> int: ...

class Card:
    def __init__(self, suit: Suit, rank: Rank) -> None: ...
    @property
    def suit(self) -> Suit: ...
    @property
    def rank(self) -> Rank: ...
    def beats(self, other: Card, led_suit: Suit) -> bool: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...

class Seat:
    def __init__(self, index: int) -> None: ...
    @property
    def index(self) -> int: ...
    def next(self, num_players: int) -> Seat: ...
    def offset(self, by: int, num_players: int) -> Seat: ...
    def __int__(self) -> int: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __lt__(self, other: Seat) -> bool: ...

class Deck:
    @staticmethod
    def standard() -> Deck: ...
    @staticmethod
    def shuffled(seed: int) -> Deck: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def cards(self) -> list[Card]: ...
    def __len__(self) -> int: ...

class Trick:
    @property
    def leader(self) -> Seat: ...
    def led_suit(self) -> Optional[Suit]: ...
    def plays(self) -> list[tuple[Seat, Card]]: ...
    def next_seat(self) -> Seat: ...
    def is_complete(self) -> bool: ...
    def winning_play(self) -> Optional[tuple[Seat, Card]]: ...
    def winner(self) -> Optional[Seat]: ...

class Round:
    def __init__(self, index: int, dealer: Seat, hands: list[list[Card]]) -> None: ...
    @property
    def index(self) -> int: ...
    @property
    def cards_dealt(self) -> int: ...
    @property
    def dealer(self) -> Seat: ...
    @property
    def num_players(self) -> int: ...
    def hand(self, seat: Seat) -> list[Card]: ...
    def bids(self) -> list[Optional[int]]: ...
    def next_bidder(self) -> Optional[Seat]: ...
    def bidding_complete(self) -> bool: ...
    def forbidden_bid(self) -> Optional[int]: ...
    def legal_bids(self) -> list[int]: ...
    def place_bid(self, seat: Seat, bid: int) -> None: ...
    def tricks(self) -> list[Trick]: ...
    def current_trick(self) -> Optional[Trick]: ...
    def next_player(self) -> Optional[Seat]: ...
    def legal_plays(self, seat: Seat) -> list[Card]: ...
    def play_card(self, seat: Seat, card: Card) -> Optional[Seat]: ...
    def is_complete(self) -> bool: ...
    def tricks_won(self, seat: Seat) -> int: ...
    def deltas(self) -> Optional[list[int]]: ...

class Phase(Enum):
    Bidding = ...
    Playing = ...
    GameOver = ...

class PlayOutcome:
    """Complex enum. Instances are one of the variant classes below; check with
    `isinstance`. Variant classes: `PlayOutcome.TrickContinues`,
    `PlayOutcome.TrickComplete`, `PlayOutcome.RoundComplete`,
    `PlayOutcome.GameOver`."""

    class TrickContinues(PlayOutcome): ...

    class TrickComplete(PlayOutcome):
        @property
        def winner(self) -> Seat: ...

    class RoundComplete(PlayOutcome):
        @property
        def trick_winner(self) -> Seat: ...
        @property
        def deltas(self) -> list[int]: ...

    class GameOver(PlayOutcome):
        @property
        def trick_winner(self) -> Seat: ...
        @property
        def deltas(self) -> list[int]: ...

class RoundResult:
    @property
    def index(self) -> int: ...
    @property
    def dealer(self) -> Seat: ...
    @property
    def bids(self) -> list[int]: ...
    @property
    def tricks_won(self) -> list[int]: ...
    @property
    def deltas(self) -> list[int]: ...

class Game:
    def __init__(self, num_players: int, seed: int) -> None: ...
    @staticmethod
    def with_first_dealer(num_players: int, seed: int, first_dealer: Seat) -> Game: ...
    @property
    def num_players(self) -> int: ...
    @property
    def seed(self) -> int: ...
    @property
    def round_index(self) -> int: ...
    @property
    def dealer(self) -> Seat: ...
    def deck(self) -> Deck: ...
    def scores(self) -> list[int]: ...
    def round(self) -> Optional[Round]: ...
    def history(self) -> list[RoundResult]: ...
    def phase(self) -> Phase: ...
    def winners(self) -> Optional[list[Seat]]: ...
    def place_bid(self, seat: Seat, bid: int) -> None: ...
    def play_card(self, seat: Seat, card: Card) -> PlayOutcome: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(data: str) -> Game: ...
